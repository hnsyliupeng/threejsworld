{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threejsworld.local/schemas/render-profile.v2.schema.json",
  "title": "ThreeJSWorld Deterministic 6-Pass Multi-Angle Render Profile v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "authority",
    "renderer",
    "environment",
    "camera",
    "turntableAzimuthsDeg",
    "passes",
    "regions",
    "feedbackGroups",
    "extensions"
  ],
  "properties": {
    "schemaVersion": { "const": "render-profile.v2" },
    "kind": { "const": "threejs-render-profile" },
    "authority": { "enum": ["browser-webgpu", "browser-webgl2"] },
    "renderer": {
      "type": "object",
      "required": [
        "backend",
        "colorManagementEnabled",
        "workingColorSpace",
        "outputColorSpace",
        "toneMapping",
        "toneMappingExposure",
        "viewport",
        "maxInFlightGpuFrames"
      ],
      "properties": {
        "backend": { "enum": ["WebGPURenderer", "WebGLRenderer"] },
        "colorManagementEnabled": { "const": true },
        "workingColorSpace": { "const": "Linear-sRGB" },
        "outputColorSpace": { "const": "SRGBColorSpace" },
        "toneMapping": {
          "enum": ["NoToneMapping", "ACESFilmicToneMapping", "AgXToneMapping", "NeutralToneMapping"]
        },
        "toneMappingExposure": { "type": "number", "exclusiveMinimum": 0 },
        "viewport": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer", "minimum": 64 }
        },
        "maxInFlightGpuFrames": { "type": "integer", "minimum": 1, "maximum": 2 }
      }
    },
    "environment": {
      "type": "object",
      "required": ["kind", "intensity"],
      "properties": {
        "kind": { "enum": ["pmrem-hdr", "pmrem-equirectangular", "hillaire-sky", "neutral-studio"] },
        "intensity": { "type": "number", "minimum": 0 }
      }
    },
    "camera": {
      "type": "object",
      "required": ["projection", "position", "target", "near", "far"],
      "properties": {
        "projection": { "enum": ["perspective", "orthographic"] },
        "position": { "type": "array", "minItems": 3, "maxItems": 3 },
        "target": { "type": "array", "minItems": 3, "maxItems": 3 },
        "near": { "type": "number", "exclusiveMinimum": 0 },
        "far": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "turntableAzimuthsDeg": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "number" }
    },
    "passes": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "required"],
        "properties": {
          "id": {
            "enum": [
              "beauty",
              "alpha-silhouette",
              "semantic-id",
              "depth",
              "normal",
              "roughness-material-id"
            ]
          },
          "required": { "type": "boolean" }
        }
      }
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "criticality", "idColor"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "criticality": { "enum": ["critical", "high", "important", "detail"] },
          "idColor": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "integer", "minimum": 0, "maximum": 255 }
          }
        }
      }
    },
    "feedbackGroups": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": ["id", "order"],
        "properties": {
          "id": {
            "enum": [
              "camera",
              "silhouette",
              "primary-form",
              "secondary-parts",
              "accessory-details",
              "materials",
              "lighting"
            ]
          },
          "order": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "extensions": {
      "type": "object",
      "required": ["requiredSemanticRegions"],
      "properties": {
        "requiredSemanticRegions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "ablationGroups": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
